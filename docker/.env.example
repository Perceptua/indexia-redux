# Indexia — environment template.
# Copy to `.env` (same dir) and fill in real values. `.env` is gitignored;
# NEVER commit real secrets.
#
# Generate strong values, e.g.:
#   openssl rand -base64 24
#
# NOTE: ArcadeDB rejects a weak root password at first init, and the root password
# is consumed ONLY when ../data is empty (first boot). Changing it later does not
# rotate the live password — reset via the console or wipe ../data.

# Root DB user password (required, strong).
ARCADEDB_ROOT_PASSWORD=CHANGE_ME_strong_root_password

# Password protecting certs/keystore.p12 (required; used by gen-cert.sh and the server).
ARCADEDB_KEYSTORE_PASSWORD=CHANGE_ME_keystore_password

# JVM heap for the ArcadeDB container (optional; default 1G). e.g. 2G on a roomier box.
ARCADEDB_HEAP=1G

# Scheduled nightly backups + retention are configured in docker/backup.json
# (ArcadeDB's built-in AutoBackupSchedulerPlugin), not here.

# Host ports (optional; default to ArcadeDB's standard 2480/2424). Override only to
# avoid a clash with another local ArcadeDB. The container-internal ports never change.
#INDEXIA_HTTP_PORT=2480
#INDEXIA_BINARY_PORT=2424

# INDEXIA_HTTP_BIND / INDEXIA_KEYSTORE are set by `scripts/up.sh --tailscale` alone —
# do NOT set them here. They widen the HTTPS port (2480) to this machine's Tailscale IP and
# switch to a tailscale-issued cert; the binary protocol (2424) always stays loopback-only,
# with no override at all. See README "Serving ArcadeDB over Tailscale".

# Embedding (optional; a local Ollama server embeds notes for the semantic layer).
# Defaults shown; uncomment to override. INDEXIA_EMBED_DIM must equal the LSM_VECTOR
# index dimension in ddl/schema.sql. Set INDEXIA_EMBED_BACKEND=none to disable embedding.
#INDEXIA_EMBED_BACKEND=ollama
#INDEXIA_EMBED_MODEL=mxbai-embed-large
#INDEXIA_EMBED_DIM=1024
#OLLAMA_HOST=http://localhost:11434
#INDEXIA_EMBED_TIMEOUT=120
# Keep the model resident so the worker doesn't pay a cold reload each poll.
#OLLAMA_KEEP_ALIVE=24h
# When to embed: 'async' (default) commits instantly and the background embed worker
# (scripts/embed-worker.sh) embeds shortly after; 'sync' embeds inline at commit (blocks).
#INDEXIA_EMBED_ON_COMMIT=async
#INDEXIA_EMBED_WORKER_INTERVAL=10   # (informational; pass --interval to embed-worker.sh)
